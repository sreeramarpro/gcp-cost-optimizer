PORT=5000
DATABASE_URL="file:./data/optimizer.db"
NODE_ENV=development

# Optional GCP Credentials Configuration
# Leave empty to run in Sandbox/Demonstration mode with realistic Compute Engine instances
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Safety Guardrails
# When true, schedule executions and manual actions will simulate changes without calling GCP mutation APIs
DRY_RUN_DEFAULT=true
SCHEDULER_ENABLED=true
